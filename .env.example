# Local development uses a SQLite file at data/coy.db and needs none of this.
#
# For a Vercel deployment, point at a Turso database instead — Vercel's
# filesystem is read-only and ephemeral, so a file-backed database loses
# every swipe.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=...

# Reset is always available in development. These two switch it on for a
# production deployment, so a reviewer can start from a clean deck:
# the first allows the route, the second shows the button in the empty state.
# ALLOW_DEMO_RESET=true
# NEXT_PUBLIC_ALLOW_DEMO_RESET=true
